// ============================================================
//  conf/hpc.config
//  HPC / SLURM cluster configuration
//  Adjust queue names and account to match your HPC system
// ============================================================

process {
    executor      = 'slurm'
    queue         = 'normal'
    clusterOptions = '--account=YOUR_ACCOUNT'

    withLabel: process_low    { queue = 'short';  time = { check_max(4.h,  'time') } }
    withLabel: process_medium { queue = 'normal'; time = { check_max(12.h, 'time') } }
    withLabel: process_high   { queue = 'long';   time = { check_max(48.h, 'time') } }
}

executor {
    queueSize    = 100
    pollInterval = '30 sec'
    submitRateLimit = '10/1min'
}

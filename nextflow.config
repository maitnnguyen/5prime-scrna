// ============================================================
//  nextflow.config  |  ReapTEC-B Pipeline Configuration
// ============================================================

manifest {
    name            = 'ReapTEC-B'
    author          = 'B Cell Enhancer Pipeline'
    description     = 'ReapTEC-based bidirectional enhancer analysis from 5\' scRNA-seq (B cells / CVID)'
    version         = '1.0.0'
    nextflowVersion = '>=23.04.0'
    mainScript      = 'main.nf'
    doi             = '10.1126/science.add8394'
}

// ── Default parameters ───────────────────────────────────────
params {
    // I/O
    input           = null
    outdir          = './results'
    help            = false

    // Genome
    genome          = 'hg38'
    fasta           = null
    gtf             = null
    star_index      = null

    // 10x Chromium 5' chemistry
    whitelist       = "${projectDir}/assets/3M-february-2018.txt"
    cb_start        = 1
    cb_len          = 16
    umi_start       = 17
    umi_len         = 12           // Next GEM: 12 | GEM-X: 12 (change clip5p too)
    clip5p          = 39           // Next GEM: 39 | GEM-X: 41
    solo_strand     = 'Forward'    // 5' chemistry is Forward stranded

    // ReapTEC-specific
    min_mapq        = 255          // STAR uniquely-mapped reads only
    bidir_gap       = 500          // Max gap (bp) between sense/antisense TSS pairs
    bidir_window    = 200          // Window around TSS peak center
    min_cpm         = 2            // log2CPM cutoff for robust TSS peaks
    min_cells_tss   = 3            // Min cells expressing a TSS peak

    // FANTOM5 reference
    fantom_bed      = null         // Auto-downloaded if null
    fantom_promoters = null
    fantom_enhancers = null

    // Seurat / downstream
    min_cells       = 3
    min_features    = 200
    max_mt_pct      = 20
    resolution      = 0.5
    n_pcs           = 30
    skip_vdj        = false
    condition_col   = 'condition'

    // BCR VDJ
    vdj_reference   = null         // Path to Cell Ranger VDJ reference

    // SCAFE parameters
    scafe_genome    = null           // e.g. hg38.gencode_v41
    scafe_atac_bw   = null           // ATAC bigwig for GLM training (optional)
    scafe_glm_model = null           // Pre-built GLM model path (optional)
    skip_scafe      = false          // Set true to skip SCAFE branch
    skip_crossval   = false          // Set true to skip cross-validation

    // Compute limits
    max_cpus        = 16
    max_memory      = '128.GB'
    max_time        = '48.h'

    // MultiQC
    multiqc_config  = "${projectDir}/assets/multiqc_config.yml"
    multiqc_title   = 'ReapTEC-B Pipeline Report'
}

// ── Process defaults ─────────────────────────────────────────
process {
    cpus   = { check_max(2    * task.attempt, 'cpus')   }
    memory = { check_max(8.GB * task.attempt, 'memory') }
    time   = { check_max(4.h  * task.attempt, 'time')   }

    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // Per-process resource allocation
    withName: STAR_INDEX {
        cpus   = { check_max(8,      'cpus')   }
        memory = { check_max(64.GB,  'memory') }
        time   = { check_max(12.h,   'time')   }
    }
    withName: STAR_ALIGN {
        cpus   = { check_max(16,     'cpus')   }
        memory = { check_max(64.GB,  'memory') }
        time   = { check_max(24.h,   'time')   }
    }
    withName: UMITOOLS_DEDUP {
        cpus   = { check_max(4,      'cpus')   }
        memory = { check_max(32.GB,  'memory') }
        time   = { check_max(12.h,   'time')   }
    }
    withName: BIDIR_ENHANCER_CALL {
        cpus   = { check_max(8,      'cpus')   }
        memory = { check_max(16.GB,  'memory') }
        time   = { check_max(6.h,    'time')   }
    }
    withName: SEURAT_CLUSTERING {
        cpus   = { check_max(8,      'cpus')   }
        memory = { check_max(32.GB,  'memory') }
        time   = { check_max(8.h,    'time')   }
    }
}

// ── Profiles ─────────────────────────────────────────────────
profiles {

    // Docker
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        conda.enabled          = false

        process {
            withName: 'FASTQC'              { container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0' }
            withName: 'TRIMGALORE'          { container = 'quay.io/biocontainers/trim-galore:0.6.10--hdfd78af_0' }
            withName: 'STAR_INDEX|STAR_ALIGN' { container = 'quay.io/biocontainers/star:2.7.11b--h43eeafb_0' }
            withName: 'UMITOOLS_DEDUP'      { container = 'quay.io/biocontainers/umi_tools:1.1.5--py38h20aed4e_1' }
            withName: 'SOFTCLIP_G_FILTER'   { container = 'quay.io/biocontainers/samtools:1.19--h50ea8bc_0' }
            withName: 'CELL_BARCODE_CTSS'   { container = 'quay.io/biocontainers/samtools:1.19--h50ea8bc_0' }
            withName: 'CTSS_COUNTS_BIGWIG'  { container = 'quay.io/biocontainers/deeptools:3.5.4--pyhdfd78af_0' }
            withName: 'BIDIR_ENHANCER_CALL' { container = 'quay.io/biocontainers/bedtools:2.31.1--hf5e1c6e_1' }
            withName: 'PROMOTER_FILTER'     { container = 'quay.io/biocontainers/bedtools:2.31.1--hf5e1c6e_1' }
            withName: 'SEURAT_CLUSTERING'   { container = 'satijalab/seurat:5.0.3' }
            withName: 'PSEUDOBULK_ENHANCER' { container = 'bioconductor/bioconductor_docker:RELEASE_3_18' }
            withName: 'MULTIQC'             { container = 'quay.io/biocontainers/multiqc:1.21--pyhdfd78af_0' }
            withName: 'SCAFE_SOLO|SCAFE_AGGREGATE|SCAFE_COUNT_AGGREGATE' { container = 'docker://cchon/scafe:latest' }
            withName: 'CROSSVALIDATE_ENHANCERS' { container = 'quay.io/biocontainers/bedtools:2.31.1--hf5e1c6e_1' }
        }
    }

    // Singularity
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false

        process {
            withName: 'FASTQC'              { container = 'https://depot.galaxyproject.org/singularity/fastqc:0.12.1--hdfd78af_0' }
            withName: 'TRIMGALORE'          { container = 'https://depot.galaxyproject.org/singularity/trim-galore:0.6.10--hdfd78af_0' }
            withName: 'STAR_INDEX|STAR_ALIGN' { container = 'https://depot.galaxyproject.org/singularity/star:2.7.11b--h43eeafb_0' }
            withName: 'UMITOOLS_DEDUP'      { container = 'https://depot.galaxyproject.org/singularity/umi_tools:1.1.5--py38h20aed4e_1' }
            withName: 'SOFTCLIP_G_FILTER|CELL_BARCODE_CTSS' { container = 'https://depot.galaxyproject.org/singularity/samtools:1.19--h50ea8bc_0' }
            withName: 'CTSS_COUNTS_BIGWIG'  { container = 'https://depot.galaxyproject.org/singularity/deeptools:3.5.4--pyhdfd78af_0' }
            withName: 'BIDIR_ENHANCER_CALL|PROMOTER_FILTER' { container = 'https://depot.galaxyproject.org/singularity/bedtools:2.31.1--hf5e1c6e_1' }
            withName: 'SEURAT_CLUSTERING'   { container = 'docker://satijalab/seurat:5.0.3' }
            withName: 'MULTIQC'             { container = 'https://depot.galaxyproject.org/singularity/multiqc:1.21--pyhdfd78af_0' }
            withName: 'SCAFE_SOLO|SCAFE_AGGREGATE|SCAFE_COUNT_AGGREGATE' { container = 'docker://cchon/scafe:latest' }
            withName: 'CROSSVALIDATE_ENHANCERS' { container = 'https://depot.galaxyproject.org/singularity/bedtools:2.31.1--hf5e1c6e_1' }
        }
    }

    // SLURM HPC
    slurm {
        process.executor       = 'slurm'
        process.clusterOptions = '--account=your_account'
        process.queue          = 'normal'
        executor.queueSize     = 50
        executor.pollInterval  = '30 sec'
    }

    // AWS Batch
    awsbatch {
        process.executor       = 'awsbatch'
        process.queue          = 'your-aws-batch-queue'
        aws.region             = 'eu-west-1'
    }

    // Test profile (minimal)
    test {
        params {
            input       = "${projectDir}/test/samplesheet_test.csv"
            genome      = 'hg38'
            max_cpus    = 4
            max_memory  = '16.GB'
            max_time    = '2.h'
            min_cpm     = 1
            min_cells   = 1
            skip_vdj    = true
        }
    }
}

// ── Reporting ─────────────────────────────────────────────────
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag.svg"
    overwrite = true
}

// ── Helper function: enforce resource caps ────────────────────
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else return obj
        } catch (all) { return obj }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else return obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        try { return Math.min(obj, params.max_cpus as int) }
        catch (all) { return obj }
    }
}

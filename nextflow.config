// ============================================================
//  nextflow.config  |  ReapTEC-B Pipeline Configuration
// ============================================================

manifest {
    name            = 'ReapTEC-B'
    author          = 'B Cell Enhancer Pipeline'
    version         = '1.0.0'
    nextflowVersion = '>=23.04.0'
}

// ── Default parameters ───────────────────────────────────────
params {

    // ── Input / Output ──────────────────────────────────────
    input           = '/home/arkku/group/ics/data/cvid_scrna_samplesheet.csv'
    outdir          = './results'
    genome          = 'hg38'           // Default genome. Override with: --genome t2t

    // ── ReapTEC / STARsolo chemistry parameters ─────────────
    // 10x Chromium Next GEM 5' v2 (standard):
    //   CB: bases 1-16 of R1, UMI: bases 17-26 of R1
    //   clip5p = 39  (16 CB + 10 UMI + 13 linker)
    // 10x Chromium GEM-X 5':
    //   CB: bases 1-16 of R1, UMI: bases 17-28 of R1
    //   clip5p = 41  (16 CB + 12 UMI + 13 linker)
    //
    // IMPORTANT: soloStrand must be 'Reverse' for 5' chemistry
    // (confirmed in official ReapTEC log file, April 2023)
    cb_start        = 1
    cb_len          = 16
    umi_start       = 17
    umi_len         = 10              // Use 12 for GEM-X
    clip5p          = 39              // Use 41 for GEM-X
    solo_strand     = 'Reverse'       // NOT Forward — 5' chemistry is Reverse in STARsolo

    // ── Reference files (genome-specific, resolved below) ───
    // Populated automatically from params.genomes[params.genome]
    // Do not set these manually — use --genome hg38 or --genome t2t
    star_index      = null
    gtf             = null
    gex_ref         = null
    vdj_ref         = null
    mask_bed        = null
    chrom_sizes     = null
    fantom_promo    = null
    fantom_enhan    = null

    // ── Genome reference map ─────────────────────────────────
    genomes {
        'hg38' {
            star_index   = "/home/arkku/group/ics/tools/genome/human_GRCH38_gencode_v49/STAR_index"
            gtf          = "/home/arkku/group/ics/resources/genome/human_GRCH38_gencode_v49/gencode.v49.primary_assembly.annotation.gtf"
            gex_ref      = "/home/arkku/group/ics/tools/refdata-gex-GRCh38-2024-A"
            vdj_ref      = "/home/arkku/group/ics/tools/cellranger/refdata-cellranger-vdj-GRCh38-alts-ensembl-7.1.0"
            chrom_sizes  = "/home/arkku/group/ics/resources/enhancer/hg38.chrom.sorted.sizes"
            fantom_promo = "/home/arkku/group/ics/resources/enhancer/hg38_fair+new_CAGE_peaks_phase1and2.edit.bed"
            fantom_enhan = "/home/arkku/group/ics/resources/enhancer/Supplementary_Data_1_Human_FANTOM-NET_enhancers.hg38.6.bed"
            mask_bed     = "/home/arkku/group/ics/resources/enhancer/Noheader_gencode.v49.chr.gene.transcript.nonlncRNA600.mask.6.bed"
        }
        't2t' {
            star_index   = "/home/arkku/group/ics/resources/genome/human_T2T/T2T_reference/star"
            gtf          = "/home/arkku/group/ics/resources/genome/human_T2T/T2T_reference/genes/genes.gtf"
            gex_ref      = "/home/arkku/group/ics/resources/genome/human_T2T/T2T_reference"
            vdj_ref      = "/home/arkku/group/ics/resources/genome/human_T2T/T2T_VDJ_reference"
            mask_bed     = "${projectDir}/assets/t2t_mask.bed"
            chrom_sizes  = "/home/arkku/group/ics/resources/genome/human_T2T/T2T_reference/chm13v2.0.chrom.sizes"
            fantom_promo = null   // No FANTOM5 for T2T yet — CTSS_COUNTS_BIGWIG will skip quantification
            fantom_enhan = null   // No FANTOM-NET for T2T yet
        }
    }

    // ── Skip flags ───────────────────────────────────────────
    skip_cellranger = false   // --skip_cellranger : reuse existing CellRanger output
    skip_fastqc     = false   // --skip_fastqc     : skip FastQC + MultiQC entirely

    // ── Compute limits ───────────────────────────────────────
    max_cpus        = 32
    max_memory      = '256.GB'
    max_time        = '72.h'

    // ── Tool paths ───────────────────────────────────────────
    container_cache = "/home/arkku/group/ics/tools/singularity_cache"
}

// ── Executor (global SLURM defaults) ────────────────────────
executor {
    name            = 'slurm'
    queue           = 'arkku'
    clusterOptions  = '--partition=arkku'
    queueSize       = 50
    submitRateLimit = '10/1min'
}

// ── Profiles ─────────────────────────────────────────────────
// Profiles are for EXECUTION ENVIRONMENT only, not genome data.
// To switch genome: nextflow run main.nf --genome t2t
// To switch executor: nextflow run main.nf -profile singularity

profiles {

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.runOptions = [
            "--no-home",
            "--bind /home/arkku/group/ics:/home/arkku/group/ics",
            "--bind /home/arkku/group/ics/user_test/Mai_test/run_pipeline/tmp:/tmp"
        ].join(' ')

        process {
            withName: 'FASTQC'             { container = "${params.container_cache}/fastqc.sif" }
            withName: 'MULTIQC'            { container = "${params.container_cache}/multiqc.sif" }
            withName: 'UMITOOLS_DEDUP'     { container = "${params.container_cache}/umi_tools_1.1.6.sif" }
            withName: 'CTSS_COUNTS_BIGWIG' { container = "${params.container_cache}/deeptools.3.5.4.sif" }
            withName: 'CELLRANGER_COUNT'   { container = "${params.container_cache}/cellranger.sif" }
            withName: 'CELLRANGER_VDJ'     { container = "${params.container_cache}/cellranger.sif " }
            // STAR_ALIGN, SOFTCLIP_G_FILTER, CTSS_BED, BIDIR_ENHANCER_CALL:
            // loaded via HPC module — no container needed
        }
    }

    // Use this profile to run locally (testing / small datasets)
    local {
        executor.name = 'local'
        params.max_cpus   = 8
        params.max_memory = '32.GB'
    }
}

// ── Process resource labels ───────────────────────────────────
process {
    // Defaults
    cpus          = { check_max(2 * task.attempt,       'cpus')   }
    memory        = { check_max(8.GB * task.attempt,    'memory') }
    time          = { check_max(4.h  * task.attempt,    'time')   }
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 2

    // TMPDIR on group storage (avoids /tmp quota issues on HPC)
    env.TMPDIR    = "/home/arkku/group/ics/user_test/Mai_test/run_pipeline/tmp"

    withLabel: process_low {
        cpus   = { check_max(2  * task.attempt, 'cpus')   }
        memory = { check_max(8.GB * task.attempt, 'memory') }
        time   = { check_max(4.h  * task.attempt, 'time')   }
    }
    withLabel: process_medium {
        cpus   = { check_max(8  * task.attempt, 'cpus')   }
        memory = { check_max(32.GB * task.attempt, 'memory') }
        time   = { check_max(8.h   * task.attempt, 'time')   }
    }
    withLabel: process_high {
        cpus   = { check_max(16 * task.attempt, 'cpus')   }
        memory = { check_max(64.GB * task.attempt, 'memory') }
        time   = { check_max(24.h  * task.attempt, 'time')   }
    }

    // Process-specific overrides
    withName: 'CELLRANGER_COUNT|CELLRANGER_VDJ' {
        cpus   = 32
        memory = 128.GB
        time   = 48.h
    }
    withName: 'STAR_ALIGN' {
        cpus   = 16
        memory = 64.GB
        time   = 12.h
    }
    withName: 'UMITOOLS_DEDUP' {
        // umi-tools is single-threaded but memory-hungry
        cpus   = 1
        memory = { check_max(32.GB * task.attempt, 'memory') }
        time   = { check_max(12.h  * task.attempt, 'time')   }
    }
}

// ── Resource cap function ─────────────────────────────────────
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else return obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        try { return Math.min(obj, params.max_cpus as int) }
        catch (all) { return obj }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else return obj
        } catch (all) { return obj }
    }
}